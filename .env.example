# Non-secret configuration values for the Intelligent Network Self-Healing Simulator.
# This app runs entirely in the browser; no server-side secrets are required.

# Default routing strategy: "shortest" or "adaptive"
VITE_DEFAULT_ROUTING_STRATEGY=adaptive

# Default auto-recovery toggle (true/false)
VITE_DEFAULT_AUTO_RECOVERY=true

# Default congestion threshold (0-1)
VITE_DEFAULT_CONGESTION_THRESHOLD=0.8
